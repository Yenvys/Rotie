# ====================================================================
# APACHE SECURITY HARDENING (.HTACCESS)
# UAS Pemrograman Web Dasar - STMIK IKMI Cirebon
# Pengembang: Muhammad Al Farel (NIM: 41257124)
# ====================================================================

# 1. Mencegah publik menjelajahi daftar isi folder (Directory Browsing)
Options -Indexes

# 2. Set Karakter Default UTF-8
AddDefaultCharset UTF-8

# 3. Kunci akses publik terhadap berkas sensitif, kredensial, dan database mentah
<FilesMatch "\.(sql|env|ini|log|sh|bak|json)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 4. Blokir akses langsung ke berkas konfigurasi rahasia dan helper internal
<FilesMatch "^(env\.php|database\.php|auth_check\.php)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

# 5. Header Keamanan Tambahan (Jika mod_headers aktif)
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
</IfModule>

