# ====================================================================
# PROTEKSI DIREKTORI UPLOAD: Cegah Eksekusi Skrip Berbahaya
# ====================================================================

Options -Indexes
Options -ExecCGI

<FilesMatch "\.(php|phtml|php3|php4|php5|php7|phps|cgi|pl|py|sh|bash)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

